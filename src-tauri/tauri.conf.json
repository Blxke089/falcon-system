{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",

  "productName": "Falcon System",
  "version": "0.1.4",
  "identifier": "com.falcon.system",

  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },

  "app": {
    "windows": [
      {
        "title": "Falcon System",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],

    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,

    "targets": [
      "nsis"
    ],

    "createUpdaterArtifacts": true,

    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },

  "plugins": {
  "updater": {
    "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0QTNGRTZERDMzNTc4NEUKUldST2VEWFRiZjZqSkpXZS96alRlZC9vWjRMdWx2azNEQU5KK3c3d2Q1WXpZNytzbFRJYzBpUC8K",

    "endpoints": [
    "https://github.com/Blxke089/falcon-system/releases/latest/download/latest.json"
    ],

    "windows": {
      "installMode": "passive"
    }
  }
}
}